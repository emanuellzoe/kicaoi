# Chain: celo | sepolia
CHAIN=celo

# Override contract address (optional, default hardcoded per chain)
# KICAOI_ADDRESS=0xb8Fb82C02acCbb0cbE613e3633781a67438563d9

# Optional custom RPC
# RPC_URL=https://forno.celo.org

# ─── Wallet fleet ───────────────────────────────────────────────
# Optimal untuk 22.51 CELO → 100 wallet × 0.225 CELO = ~44 jam aktif, ~267k TX
NUM_WALLETS=100
FUNDER_PRIVATE_KEY=aDWe (xxxxxx)         # Wallet dedicated (BUKAN wallet personal)
FUND_PER_WALLET=0.225        # 22.51 / 100 = 0.2251 CELO per wallet

# ─── Farm settings ──────────────────────────────────────────────
# 1=Wheat (5 min, 5 SEED) | 2=Pumpkin (30 min, 20 SEED) | 3=Golden (2 hr, 60 SEED)
CROP_ID=1
BUY_SEED_CELO=0.05           # 0.05 CELO = 5 SEED (refill kecil, hemat gas budget)

# ─── Seed-spam mode (buySeeds saja, tanpa farm) ─────────────────
SPAM_BUY_MIN=0.01            # 0.01 CELO = 1 SEED (nilai minimal valid)
SPAM_PER_RUN=3               # buySeeds per wallet per run

# ─── Operasional ────────────────────────────────────────────────
CONCURRENCY=10               # wallet paralel (naikkan sesuai kecepatan RPC)
MIN_GAS_RESERVE=0.003        # CELO minimum cadangan gas (Celo baseFee ~200 Gwei)
